// Versi Linux agent (sh)
pipeline {
    agent any

    triggers { githubPush() }

    environment {
        // GANTI 'USERNAME_DOCKERHUB' dengan username Docker Hub Anda
        IMAGE_NAME           = 'USERNAME_DOCKERHUB/jenkins-flask-mysql'
        IMAGE_TAG            = "${BUILD_NUMBER}"
        REGISTRY_CREDENTIALS = 'dockerhub-credentials'
        COMPOSE_PROJECT_NAME = 'flaskdb'
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Build') {
            steps {
                sh 'echo "Mulai build aplikasi nomor $BUILD_NUMBER"'
                sh 'docker --version'
                sh 'docker compose config -q'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest .'
                sh 'docker build -t $IMAGE_NAME-db:$IMAGE_TAG ./db'
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: REGISTRY_CREDENTIALS,
                                                  usernameVariable: 'USER',
                                                  passwordVariable: 'PASS')]) {
                    sh 'echo "$PASS" | docker login -u "$USER" --password-stdin'
                    sh 'docker push $IMAGE_NAME:$IMAGE_TAG'
                    sh 'docker push $IMAGE_NAME:latest'
                    sh 'docker push $IMAGE_NAME-db:$IMAGE_TAG'
                }
            }
        }

        stage('Deploy (App + Database)') {
            steps {
                sh 'docker compose up -d --wait'
                sh 'docker compose ps'
            }
        }
    }

    post {
        always  { sh 'docker logout' }
        success { echo 'Pipeline sukses: aplikasi dan database berjalan di port 5000' }
        failure { echo 'Pipeline gagal, cek Console Output' }
    }
}
